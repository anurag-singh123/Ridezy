# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_API_KEY: Optional Google Maps Platform API key for live map tiles & Places autocomplete
VITE_GOOGLE_MAPS_API_KEY=""

# FIREBASE CONFIGURATION: Optional production Firebase Auth & Firestore credentials
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""

# PAYMENT GATEWAY: Server-side Razorpay / Stripe credentials (never expose secret keys to client)
PAYMENT_GATEWAY_KEY_ID=""
PAYMENT_GATEWAY_KEY_SECRET=""

# RIDE PROVIDER ADAPTER CREDENTIALS: Server-side ONDC / Beckn / Fleet partner credentials
ONDC_BAP_ID=""
ONDC_BAP_URI=""
ONDC_SIGNING_PRIVATE_KEY=""
